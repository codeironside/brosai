NODE_ENV=production
HOST=127.0.0.1
PORT=3124

DB_NAME=brosai
DB_URI=mongodb+srv://USER:PASS@CLUSTER/?appName=brosai

CORS_ORIGINS=https://vamvamvamai.com,https://www.vamvamvamai.com

FRONTEND_URL=https://vamvamvamai.com
SOCIAL_OAUTH_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback
TWITTER_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback
LINKEDIN_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback
FACEBOOK_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback
THREADS_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback
YOUTUBE_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback
TIKTOK_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback
INSTAGRAM_REDIRECT_URI=https://api.vamvamvamai.com/api/social/callback

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
FIRECRAWL_API_KEY=
GEMMA_API_KEY=
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL=gemma-4-31b-it
GEMMA_IMAGE_MODEL=gemini-3.1-flash-image

# Multi-provider LLM failover (free → paid). Prefer :free OpenRouter models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODELS=qwen/qwen-2.5-72b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,deepseek/deepseek-r1:free
# gsk_ keys belong here (Groq). Put a real hf_ token in HUGGINGFACE_API_KEY for HF Inference.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODELS=gemma2-9b-it,mixtral-8x7b-32768
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_MODELS=google/gemma-2-9b-it,mistralai/Mistral-7B-Instruct-v0.3,meta-llama/Llama-3.2-3B-Instruct
LLM_PROVIDER_ORDER=openrouter,huggingface,groq,openai

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
DEFAULT_USER_ROLE=user
TOKEN_ENCRYPTION_KEY=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_OAUTH_MODE=instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on that Google OAuth Web client
GOOGLE_MOBILE_CALLBACK_URL=https://api.vamvamvamai.com/api/auth/google/mobile/callback

# Mobile push: Expo Push Tokens are stored on User.pushTokens via POST /api/auth/push-token
# Sends go through Expo Push API when automation needs approval or clarification

