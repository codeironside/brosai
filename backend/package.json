{
  "name": "brosai-backend",
  "version": "1.0.0",
  "description": "Enterprise Express.js TypeScript Backend for Bros AI following API / APP / CORE architecture",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/server.ts",
    "dev:staging": "tsx watch --env-file=.env.staging src/server.ts",
    "dev:uat": "tsx watch --env-file=.env.uat src/server.ts",
    "dev:prod": "tsx watch --env-file=.env.production src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
